# Paper Desk talks only to Alpaca Paper.
# Server routes hardcode https://paper-api.alpaca.markets
# Anything that points at live api.alpaca.markets will hard-fail.

ALPACA_API_KEY=
ALPACA_API_SECRET=

# Must be exactly true. Any other value refuses to start.
ALPACA_PAPER=true

# Optional ISO-8601 start of the 30-day maximize-ROI test.
# Example: 2026-09-19T00:00:00.000Z
DESK_START_ISO=
