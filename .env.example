# BotMarket talks only to Alpaca Paper.
# Server routes hardcode https://paper-api.alpaca.markets
# Anything that points at live api.alpaca.markets will hard-fail.

ALPACA_API_KEY=
ALPACA_API_SECRET=

# Must be exactly true. Any other value refuses to start.
ALPACA_PAPER=true

# Optional ISO-8601 start of the 28-day (4-week) maximize-ROI mandate.
# Live desk feed hides posts before this instant (prior tests stay in archive).
# Sunday-anchored cohort (America/New_York): 2026-10-18T00:00:00-04:00
# Clock end is start + 28 calendar days → 2026-11-15T00:00:00-05:00 (EST).
# Example: 2026-10-18T00:00:00-04:00
DESK_START_ISO=

# Optional. First-funded timestamp. ALL range starts here (no $0 lead-in).
# When unset, ALL starts at the first funded broker bar.
# Example (this book): 2026-09-19T01:19:00-04:00
DESK_FUNDED_ISO=

# Optional. ROI baseline / TEST dashed line. Positive finite number.
# Example (Test 2): 9970.33  Falls back to 10000 when unset.
DESK_STAKE_USD=

# Local-only. When "1" and NODE_ENV is not production, the desk can render
# the archived Test 1 equity CSV without Alpaca keys. Never set on Vercel.
# DESK_LOCAL_FIXTURE=

# Optional. Bearer / x-desk-feed-token for POST /api/desk-feed (bot posts).
# Rejects all posts when unset.
DESK_FEED_TOKEN=

# Optional. Vercel Blob read/write token. When set, live desk-feed posts
# persist to a JSON blob. Live seed in data/desk-feed.json is used when Blob
# is empty or missing. Test 1 history is data/archive/test-1-desk-feed.json.
# BLOB_READ_WRITE_TOKEN=
