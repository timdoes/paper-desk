# BotMarket talks only to Alpaca Paper.
# Server routes hardcode https://paper-api.alpaca.markets
# Anything that points at live api.alpaca.markets will hard-fail.

ALPACA_API_KEY=
ALPACA_API_SECRET=

# Must be exactly true. Any other value refuses to start.
ALPACA_PAPER=true

# Optional ISO-8601 start of the 28-day (4-week) maximize-ROI mandate.
# Sunday-anchored cohort (America/New_York): 2026-09-20T00:00:00-04:00
# Clock end is start + 28 calendar days → 2026-10-18T00:00:00-04:00.
# Example: 2026-09-20T00:00:00-04:00
DESK_START_ISO=

# Optional. First-funded timestamp for the equity-curve $0 lead-in.
# When unset, the curve uses DESK_START_ISO, then the first funded broker bar.
# Set this when mandate Sunday and first-funded differ, so Saturday activity
# stays on the curve. Example (this book): 2026-09-19T01:19:00-04:00
DESK_FUNDED_ISO=

# Optional. Bearer / x-desk-feed-token for POST /api/desk-feed (bot posts).
# Rejects all posts when unset.
DESK_FEED_TOKEN=

# Optional. Vercel Blob read/write token. When set, live desk-feed posts
# persist to a JSON blob. Seed in data/desk-feed.json is used when Blob
# is empty or missing.
# BLOB_READ_WRITE_TOKEN=
